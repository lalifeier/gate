# 本地 / 开发环境
# Cloudflare Worker 与 Vercel 共用的变量（复制为 .env 使用）

# 必填：VLESS 用户 UUID（生成：uuidgen 或 crypto.randomUUID()）
UUID=

# 必填：后台与订阅的访问口令
ADMIN=

# 链式模式：always（失败即失败）| fallback（失败退回直连）| direct（不走 SSTP）
CHAIN=always

# 节点池（逗号分隔 host:port），留空则读 KV / POOL_URL / public/nodes.json
SSTP_POOL=

# 节点池外链：定时任务发布到 GitHub Pages 的那份 nodes.json
# Vercel 侧没有 KV，这是拿到「本轮检测结果」的唯一途径；
# 留空则 Vercel 会冻结在上次部署时的 public/nodes.json
# 例：https://<user>.github.io/<repo>/nodes.json
POOL_URL=

# 池缓存 TTL（毫秒），热路径不会每次建连都拉一次外链
POOL_CACHE_TTL_MS=90000

# SSTP 登录凭据（VPN Gate 公共节点默认 vpn/vpn）
SSTP_USER=vpn
SSTP_PASS=vpn

# 出口探测目标
PROBE_TARGET=ip-api.com

# 订阅输出用的节点域名（留空则用当前请求域名）
NODE_HOST=

# /nodes.txt 每行的入口域名（留空则用节点自身 host:port）
EDGE_HOSTS=

# 开发期出网代理（本地直连 VPN Gate 节点通常不通）
DIAL_PROXY=
